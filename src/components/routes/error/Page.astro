---
import Layout from "@/components/routes/Layout.astro";
import { Glass, Group } from "@/components/shared/Sections";
import { PageTitle, Paragraph } from "@/components/shared/Typography";
import { GlassButton } from "@/components/integrations";
---
<Layout dir="/error" meta={ { title: '404 Not Found' } }>
	<main>
		<Glass as="section">
			<PageTitle icon="home">404 Not Found</PageTitle>
			<Paragraph>お探しのページは存在しないか、移動された可能性があります。</Paragraph>
			<Group>
				<GlassButton as="a" href="/">Home</GlassButton>
			</Group>
		</Glass>
	</main>
</Layout>
